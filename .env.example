# Environment variables read by mysite/settings.py. Names only; never commit real values.

# Postgres connection string. Set in Railway as a reference to ${{Postgres.DATABASE_URL}}; leave unset locally to use SQLite.
DATABASE_URL=

# Long random string unique to this app. Set in Railway (e.g. ${{secret(50)}}); optional locally.
SECRET_KEY=

# Set automatically by Railway; turns off debug mode and requires DATABASE_URL and SECRET_KEY. Leave unset locally.
RAILWAY_ENVIRONMENT_NAME=

# Set automatically by Railway once the service has a public domain; used for allowed hosts and form security. Leave unset locally.
RAILWAY_PUBLIC_DOMAIN=
